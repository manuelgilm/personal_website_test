{
  "routes": [
    { "route": "/_astro/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/pagefind/*", "headers": { "cache-control": "public, max-age=604800" } },
    { "route": "/assets/*", "headers": { "cache-control": "public, max-age=604800" } },
    { "route": "/play/*", "headers": { "cache-control": "public, max-age=604800" } },

    { "route": "/index.html", "redirect": "/", "statusCode": 301 },
    { "route": "/home.html", "redirect": "/", "statusCode": 301 },
    { "route": "/blog-grid.html", "redirect": "/ai/articles/", "statusCode": 301 },
    { "route": "/blog-single.html", "redirect": "/ai/articles/", "statusCode": 301 },
    { "route": "/portfolio-details.html", "redirect": "/ai/projects/", "statusCode": 301 },
    { "route": "/ai-room.html", "redirect": "/ai/projects/mlflow/", "statusCode": 301 },

    { "route": "/ai/projects/ai-room*", "redirect": "/ai/projects/mlflow/", "statusCode": 301 },
    { "route": "/es/ai/projects/ai-room*", "redirect": "/es/ai/projects/mlflow/", "statusCode": 301 },

    { "route": "/docs/site_en/engineering_channel/automating_youtube_with_ai/01_intro*", "redirect": "/ai/tutorials/automating_youtube_with_ai/01_intro/", "statusCode": 301 },
    { "route": "/docs/site_en/engineering_channel/mlflow_for_ml_dev/experiment_tracking_basics*", "redirect": "/ai/tutorials/mlflow_for_ml_dev/experiment_tracking_basics/", "statusCode": 301 },
    { "route": "/docs/site_en/engineering_channel/yt_bot_series/01_architecture_and_setup*", "redirect": "/ai/tutorials/yt_bot_series/01_architecture_and_setup/", "statusCode": 301 },
    { "route": "/docs/site_en/engineering_channel/yt_bot_series/02_skeleton_bot*", "redirect": "/ai/tutorials/yt_bot_series/02_skeleton_bot/", "statusCode": 301 },
    { "route": "/docs/site_en/engineering_channel/yt_bot_series/03_prompt_engineering_mlflow*", "redirect": "/ai/tutorials/yt_bot_series/03_prompt_engineering_mlflow/", "statusCode": 301 },
    { "route": "/docs/site_en/engineering_channel/yt_bot_series/04_github_actions*", "redirect": "/ai/tutorials/yt_bot_series/04_github_actions/", "statusCode": 301 },
    { "route": "/docs/site_en/engineering_channel/yt_bot_series/05_system_as_whole*", "redirect": "/ai/tutorials/yt_bot_series/05_system_as_whole/", "statusCode": 301 },

    { "route": "/docs/site_es/engineering_channel/yt_bot_series/01_architecture_and_setup*", "redirect": "/es/ai/tutorials/yt_bot_series/01_architecture_and_setup/", "statusCode": 301 },
    { "route": "/docs/site_es/engineering_channel/yt_bot_series/02_skeleton_bot*", "redirect": "/es/ai/tutorials/yt_bot_series/02_skeleton_bot/", "statusCode": 301 },
    { "route": "/docs/site_es/engineering_channel/yt_bot_series/03_prompt_engineering_mlflow*", "redirect": "/es/ai/tutorials/yt_bot_series/03_prompt_engineering_mlflow/", "statusCode": 301 },
    { "route": "/docs/site_es/engineering_channel/yt_bot_series/04_github_actions*", "redirect": "/es/ai/tutorials/yt_bot_series/04_github_actions/", "statusCode": 301 },
    { "route": "/docs/site_es/engineering_channel/yt_bot_series/05_system_as_whole*", "redirect": "/es/ai/tutorials/yt_bot_series/05_system_as_whole/", "statusCode": 301 },

    { "route": "/docs/site_en*", "redirect": "/ai/tutorials/", "statusCode": 301 },
    { "route": "/docs/site_es*", "redirect": "/es/ai/tutorials/", "statusCode": 301 },
    { "route": "/docs*", "redirect": "/ai/tutorials/", "statusCode": 301 },

    { "route": "/mlflow*", "redirect": "/ai/tutorials/mlflow_for_ml_dev/experiment_tracking_basics/", "statusCode": 301 },
    { "route": "/bot*", "redirect": "/ai/tutorials/yt_bot_series/01_architecture_and_setup/", "statusCode": 301 }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "mimeTypes": {
    ".json": "text/json",
    ".wasm": "application/wasm"
  }
}
