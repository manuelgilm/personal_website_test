---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { defaultLang, type Lang } from "../../i18n/ui";
import { localizePath, useTranslations } from "../../i18n/utils";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<BaseLayout
  title={t("contact.thanks.title")}
  description={t("contact.thanks.body")}
  noindex
  languagePath=""
>
  <section class="section">
    <div class="container">
      <h1>{t("contact.thanks.lead")}</h1>
      <p class="lead">{t("contact.thanks.body")}</p>
      <div class="actions">
        <a class="btn primary" href={localizePath(lang, "")}>{t("contact.thanks.cta")}</a>
      </div>
    </div>
  </section>
</BaseLayout>
