---
import ArticlePage from "../../../components/ArticlePage.astro";
import { articlePath, getArticles } from "../../../lib/articles";

export async function getStaticPaths() {
  const prefix = "rides/stories/";
  const entries = await getArticles("en", { vertical: "rides", kind: "story" });
  return entries.map((entry) => {
    const path = articlePath(entry);
    return { params: { slug: path.slice(prefix.length) }, props: { path } };
  });
}

const { path } = Astro.props;
---

<ArticlePage path={path} />
