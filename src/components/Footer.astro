---
import { SITE } from "../consts";
import { defaultLang, type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const socials = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/manuelgilmatheus" },
  { label: "GitHub", href: "https://github.com/manuelgilm" },
  { label: "Medium", href: "https://www.medium.com/@manuel-gilm" },
  { label: "YouTube", href: "https://www.youtube.com/channel/UCfyRomJP2C9r8qBuug1hxVA" },
  { label: "Instagram", href: "https://www.instagram.com/gilsamas/" },
];
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="container">
    <ul class="socials">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer me">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p>&copy; {year} {SITE.name}. {t("footer.rights")}</p>
    <p class="credits">{t("footer.credits")}</p>
  </div>
</footer>
