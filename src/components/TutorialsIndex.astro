---
import { render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { SITE } from "../consts";
import { defaultLang, type Lang } from "../i18n/ui";
import { localizePath, useTranslations } from "../i18n/utils";
import {
  getAvailableLocales,
  getSidebar,
  getTutorialByPath,
} from "../lib/tutorials";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const entry = await getTutorialByPath(lang, "");

if (!entry) {
  throw new Error(`Tutorials index not found for locale: ${lang}`);
}

const groups = await getSidebar(lang);
const availableLocales = await getAvailableLocales("");
const { Content } = await render(entry);

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t("nav.home"), item: new URL(localizePath(lang, ""), site).href },
      { "@type": "ListItem", position: 2, name: t("nav.ai"), item: new URL(localizePath(lang, "ai"), site).href },
      { "@type": "ListItem", position: 3, name: t("nav.ai.tutorials"), item: canonical },
    ],
  },
];
---

<DocsLayout
  title={`${entry.data.title} | Manuel Gil`}
  description={entry.data.description}
  currentPath=""
  groups={groups}
  availableLocales={availableLocales}
  jsonLd={jsonLd}
>
  <Content />
</DocsLayout>
